#!/usr/bin/env bash
# micboostctl — tune the micboost mic processor and hot-apply.
set -euo pipefail

CFG="${XDG_CONFIG_HOME:-$HOME/.config}/micboost/config"
LABEL="me.pecheny.micboost"
DOMAIN="gui/$(id -u)/$LABEL"
LOG="/tmp/micboost.log"

mkdir -p "$(dirname "$CFG")"
[ -f "$CFG" ] || : > "$CFG"

get() { # get KEY -> value from config ('' if unset)
  awk -v k="$1" -F= '$0 ~ "^[[:space:]]*"k"[[:space:]]*=" {v=$2; sub(/#.*/,"",v); gsub(/^[ \t]+|[ \t]+$/,"",v); print v; exit}' "$CFG"
}

setkv() { # setkv KEY VALUE  (upsert, preserving any inline comment)
  local k="$1" v="$2" tmp; tmp="$(mktemp)"
  awk -v k="$k" -v v="$v" '
    { if (!done && $0 ~ "^[[:space:]]*"k"[[:space:]]*=") {
        cmt=""; if (match($0,/#.*/)) cmt="   " substr($0,RSTART)
        printf "%s=%s%s\n", k, v, cmt; done=1; next }
      print }
    END { if (!done) printf "%s=%s\n", k, v }
  ' "$CFG" > "$tmp" && mv "$tmp" "$CFG"
}

apply() { launchctl kickstart -k "$DOMAIN" >/dev/null 2>&1 && echo "applied → restarted micboost"; }

num() { # arithmetic with float support
  awk "BEGIN{printf \"%g\", $1}"
}

usage() {
cat <<'EOF'
micboostctl — tune the RODE→BlackHole mic processor (auto-restarts on change)

  micboostctl show                 show current settings
  micboostctl status               launchd status
  micboostctl log                  tail the log

  micboostctl gain <dB>            set absolute pre-boost   (e.g. gain 15)
  micboostctl gain +3 | -2         nudge boost relative
  micboostctl comp on | off        compressor on/off
  micboostctl threshold <dB>       compressor threshold     (e.g. -18)
  micboostctl ratio <x>            compressor ratio         (e.g. 4)
  micboostctl makeup <dB>          post-compressor makeup gain
  micboostctl attack <ms>          envelope attack
  micboostctl release <ms>         envelope release
  micboostctl set KEY VALUE        set any raw key

  micboostctl restart              re-apply without changes
EOF
}

case "${1:-help}" in
  show)
    echo "config: $CFG"
    for k in GAIN_DB COMP THRESH_DB RATIO MAKEUP_DB ATTACK_MS RELEASE_MS RODE_NAME OUT_NAME; do
      v="$(get "$k")"; printf "  %-11s %s\n" "$k" "${v:-<default>}"
    done ;;
  status) launchctl print "$DOMAIN" 2>/dev/null | grep -E "state =|pid =" | head -3 || echo "not loaded" ;;
  log)    tail -n 40 -f "$LOG" ;;

  gain)
    [ $# -ge 2 ] || { echo "usage: micboostctl gain <dB|+N|-N>"; exit 1; }
    a="$2"
    if [[ "$a" == +* || "$a" == -* ]]; then
      cur="$(get GAIN_DB)"; cur="${cur:-12}"; new="$(num "$cur + ($a)")"
    else new="$a"; fi
    setkv GAIN_DB "$new"; echo "GAIN_DB = $new dB"; apply ;;

  comp)
    case "${2:-}" in on|1) setkv COMP 1;; off|0) setkv COMP 0;; *) echo "usage: micboostctl comp on|off"; exit 1;; esac
    echo "COMP = $(get COMP)"; apply ;;

  threshold) setkv THRESH_DB "$2";  echo "THRESH_DB = $2 dB"; apply ;;
  ratio)     setkv RATIO "$2";      echo "RATIO = $2";        apply ;;
  makeup)    setkv MAKEUP_DB "$2";  echo "MAKEUP_DB = $2 dB"; apply ;;
  attack)    setkv ATTACK_MS "$2";  echo "ATTACK_MS = $2 ms"; apply ;;
  release)   setkv RELEASE_MS "$2"; echo "RELEASE_MS = $2 ms"; apply ;;

  set)
    [ $# -ge 3 ] || { echo "usage: micboostctl set KEY VALUE"; exit 1; }
    setkv "$2" "$3"; echo "$2 = $3"; apply ;;

  restart) apply ;;
  help|-h|--help) usage ;;
  *) echo "unknown command: $1"; echo; usage; exit 1 ;;
esac
